{
 "film": "sintel",
 "lang": "ur",
 "segments": [
  {
   "start": 106.8,
   "end": 109.26,
   "v": "m2",
   "text": "اس تلوار کا ماضی بہت تاریک ہے،"
  },
  {
   "start": 111.75,
   "end": 113.93,
   "v": "m2",
   "text": "اس نے بہت سے بے گناہوں کا خون بہایا ہے۔"
  },
  {
   "start": 117.81,
   "end": 120.17,
   "v": "m2",
   "text": "بے وقوف ہو، بنا تیاری کے اکیلی سفر کر رہی ہو۔"
  },
  {
   "start": 120.99,
   "end": 122.95,
   "v": "m2",
   "text": "خوش قسمت ہو کہ ابھی زندہ ہو۔"
  },
  {
   "start": 125.09,
   "end": 125.65,
   "v": "f",
   "text": "شکریہ۔"
  },
  {
   "start": 127.52,
   "end": 127.8,
   "v": "m2",
   "text": "تو،"
  },
  {
   "start": 129.16,
   "end": 131.32,
   "v": "m2",
   "text": "دربانوں کی سرزمین میں کیسے آنا ہوا؟"
  },
  {
   "start": 135.09,
   "end": 136.45,
   "v": "f",
   "text": "میں کسی کو ڈھونڈ رہی ہوں۔"
  },
  {
   "start": 137.57,
   "end": 138.69,
   "v": "m2",
   "text": "کوئی بہت پیارا؟"
  },
  {
   "start": 139.77,
   "end": 140.67,
   "v": "m2",
   "text": "کوئی ہم دم؟"
  },
  {
   "start": 143.36,
   "end": 143.96,
   "v": "f",
   "text": "ایک ڈریگن۔"
  },
  {
   "start": 153.04,
   "end": 155.22,
   "v": "f",
   "text": "جب سے یاد ہے، میں اکیلی ہی رہی ہوں۔"
  },
  {
   "start": 206.04,
   "end": 207.8,
   "v": "f",
   "text": "ارے! شش، شش۔"
  },
  {
   "start": 207.86,
   "end": 208.64,
   "v": "f",
   "text": "بس ہو گیا۔"
  },
  {
   "start": 210.3,
   "end": 211.84,
   "v": "f",
   "text": "ارے، آرام سے بیٹھو۔"
  },
  {
   "start": 227.66,
   "end": 228.74,
   "v": "f",
   "text": "شب بخیر، اسکیلز۔"
  },
  {
   "start": 249.82,
   "end": 252.26,
   "v": "f",
   "text": "پکڑو اسے، اسکیلز! چلو، پکڑو!"
  },
  {
   "start": 264.74,
   "end": 265.38,
   "v": "f",
   "text": "اسکیلز؟"
  },
  {
   "start": 445.5,
   "end": 446.6,
   "v": "f",
   "text": "میں ہار گئی۔"
  },
  {
   "start": 452.64,
   "end": 454.0,
   "v": "m2",
   "text": "تم بس دیکھ نہیں پائیں۔"
  },
  {
   "start": 457.52,
   "end": 459.28,
   "v": "m2",
   "text": "یہ ڈریگنوں کی سرزمین ہے، سنٹیل۔"
  },
  {
   "start": 460.24,
   "end": 461.6,
   "v": "m2",
   "text": "تم سوچ سے زیادہ قریب ہو۔"
  }
 ]
}