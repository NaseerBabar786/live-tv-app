{
 "film": "sintel",
 "lang": "hi",
 "segments": [
  {
   "start": 106.8,
   "end": 109.26,
   "v": "m2",
   "text": "इस तलवार का अतीत बहुत अंधेरा है,"
  },
  {
   "start": 111.75,
   "end": 113.93,
   "v": "m2",
   "text": "इसने बहुत से बेगुनाहों का ख़ून बहाया है।"
  },
  {
   "start": 117.81,
   "end": 120.17,
   "v": "m2",
   "text": "बेवक़ूफ़ हो, बिना तैयारी के अकेली सफ़र कर रही हो।"
  },
  {
   "start": 120.99,
   "end": 122.95,
   "v": "m2",
   "text": "क़िस्मत अच्छी है कि अभी ज़िंदा हो।"
  },
  {
   "start": 125.09,
   "end": 125.65,
   "v": "f",
   "text": "शुक्रिया।"
  },
  {
   "start": 127.52,
   "end": 127.8,
   "v": "m2",
   "text": "तो,"
  },
  {
   "start": 129.16,
   "end": 131.32,
   "v": "m2",
   "text": "द्वारपालों की धरती पर कैसे आना हुआ?"
  },
  {
   "start": 135.09,
   "end": 136.45,
   "v": "f",
   "text": "मैं किसी को ढूँढ रही हूँ।"
  },
  {
   "start": 137.57,
   "end": 138.69,
   "v": "m2",
   "text": "कोई बहुत प्यारा?"
  },
  {
   "start": 139.77,
   "end": 140.67,
   "v": "m2",
   "text": "कोई हमदम?"
  },
  {
   "start": 143.36,
   "end": 143.96,
   "v": "f",
   "text": "एक ड्रैगन।"
  },
  {
   "start": 153.04,
   "end": 155.22,
   "v": "f",
   "text": "जब से याद है, मैं अकेली ही रही हूँ।"
  },
  {
   "start": 206.04,
   "end": 207.8,
   "v": "f",
   "text": "अरे! शश, शश।"
  },
  {
   "start": 207.86,
   "end": 208.64,
   "v": "f",
   "text": "बस हो गया।"
  },
  {
   "start": 210.3,
   "end": 211.84,
   "v": "f",
   "text": "अरे, आराम से बैठो।"
  },
  {
   "start": 227.66,
   "end": 228.74,
   "v": "f",
   "text": "शुभ रात्रि, स्केल्स।"
  },
  {
   "start": 249.82,
   "end": 252.26,
   "v": "f",
   "text": "पकड़ो उसे, स्केल्स! चलो, पकड़ो!"
  },
  {
   "start": 264.74,
   "end": 265.38,
   "v": "f",
   "text": "स्केल्स?"
  },
  {
   "start": 445.5,
   "end": 446.6,
   "v": "f",
   "text": "मैं हार गई।"
  },
  {
   "start": 452.64,
   "end": 454.0,
   "v": "m2",
   "text": "तुम बस देख नहीं पाईं।"
  },
  {
   "start": 457.52,
   "end": 459.28,
   "v": "m2",
   "text": "ये ड्रैगनों की धरती है, सिंटेल।"
  },
  {
   "start": 460.24,
   "end": 461.6,
   "v": "m2",
   "text": "तुम सोच से ज़्यादा क़रीब हो।"
  }
 ]
}