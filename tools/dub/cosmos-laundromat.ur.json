{
 "film": "cosmos-laundromat",
 "lang": "ur",
 "segments": [
  {
   "start": 139.98,
   "end": 140.92,
   "v": "m2",
   "text": "معاف کیجیے۔"
  },
  {
   "start": 142.06,
   "end": 142.76,
   "v": "m2",
   "text": "معاف کیجیے، جناب۔"
  },
  {
   "start": 144.14,
   "end": 144.82,
   "v": "m2",
   "text": "سنیے۔"
  },
  {
   "start": 150.37,
   "end": 151.19,
   "v": "m2",
   "text": "ایک منٹ ہے، جناب؟"
  },
  {
   "start": 152.33,
   "end": 154.83,
   "v": "m",
   "text": "میں ذرا ایک کام میں مصروف ہوں۔"
  },
  {
   "start": 155.13,
   "end": 156.45,
   "v": "m2",
   "text": "جی، شکریہ۔"
  },
  {
   "start": 156.83,
   "end": 158.01,
   "v": "m2",
   "text": "میں آپ کے لیے بہت دور سے آیا ہوں، فرینک۔"
  },
  {
   "start": 169.42,
   "end": 170.14,
   "v": "m2",
   "text": "میرا نام وکٹر ہے۔"
  },
  {
   "start": 175.02,
   "end": 175.96,
   "v": "m2",
   "text": "اور آپ ہیں…"
  },
  {
   "start": 177.46,
   "end": 178.26,
   "v": "m",
   "text": "فرینک۔"
  },
  {
   "start": 180.52,
   "end": 183.9,
   "v": "m2",
   "text": "آپ صرف ایک بھیڑ سے کہیں بڑھ کر ہیں، ہے نا؟"
  },
  {
   "start": 184.8,
   "end": 185.28,
   "v": "m",
   "text": "اچھا؟"
  },
  {
   "start": 186.78,
   "end": 188.04,
   "v": "m",
   "text": "آپ کو کیسے پتا؟"
  },
  {
   "start": 190.44,
   "end": 192.54,
   "v": "m2",
   "text": "خود کو دیکھیے۔ آپ مہم جو ہیں، فرینک۔"
  },
  {
   "start": 192.54,
   "end": 196.52,
   "v": "m2",
   "text": "بالکل میری طرح، اکیلے بھیڑیے۔"
  },
  {
   "start": 198.75,
   "end": 201.71,
   "v": "m2",
   "text": "بتائیے، کیا کوئی اپنی مرضی سے اکیلا ہوتا ہے؟"
  },
  {
   "start": 202.97,
   "end": 204.37,
   "v": "m2",
   "text": "نہیں، نہیں ہوتا۔"
  },
  {
   "start": 205.09,
   "end": 207.01,
   "v": "m2",
   "text": "کوئی بھیڑیا بننا بھی خود نہیں چنتا۔"
  },
  {
   "start": 209.99,
   "end": 210.59,
   "v": "m2",
   "text": "یا چنتا ہے؟"
  },
  {
   "start": 215.49,
   "end": 217.17,
   "v": "m",
   "text": "دیکھیے، جناب…"
  },
  {
   "start": 217.89,
   "end": 219.61,
   "v": "m2",
   "text": "وکٹر۔ وکٹر۔"
  },
  {
   "start": 219.95,
   "end": 225.19,
   "v": "m",
   "text": "مجھے نہیں پتا آپ کیا کہہ رہے ہیں، میں تو ایک بھیڑ ہوں جو اپنے کام سے کام رکھتی ہے۔"
  },
  {
   "start": 226.51,
   "end": 228.73,
   "v": "m",
   "text": "آپ بھی یہی کیجیے۔"
  },
  {
   "start": 228.73,
   "end": 236.23,
   "v": "m2",
   "text": "نہیں نہیں نہیں، فرینک، رکیے، رکیے! یہ طریقہ نہیں۔ بس مجھے ایک منٹ دیجیے،"
  },
  {
   "start": 236.23,
   "end": 243.51,
   "v": "m2",
   "text": "آپ کے قیمتی وقت کا۔ ہاں، بس ایک منٹ۔"
  },
  {
   "start": 243.51,
   "end": 246.23,
   "v": "m2",
   "text": "ایک منٹ تو ہوگا آپ کے پاس، ہے نا؟"
  },
  {
   "start": 247.83,
   "end": 250.85,
   "v": "m2",
   "text": "اچھا، آدھا۔ آدھا منٹ۔"
  },
  {
   "start": 270.18,
   "end": 277.22,
   "v": "m2",
   "text": "آپ کو پچھتاوا نہیں ہوگا! کیسی کیسی مہمیں، وہ ساری زندگیاں جو آپ"
  },
  {
   "start": 277.22,
   "end": 284.24,
   "v": "m2",
   "text": "ہمیشہ چاہتے تھے، جو کچھ آپ سے چھوٹ گیا۔ ہاں، یہ ہماری دکان کی"
  },
  {
   "start": 284.24,
   "end": 291.44,
   "v": "m2",
   "text": "سب سے بہترین چیز ہے۔ بدلتی رفتار، شاندار گھماؤ، سب ایک ہی"
  },
  {
   "start": 291.44,
   "end": 295.38,
   "v": "m2",
   "text": "مشین میں۔ بالکل صاف ستھری۔"
  },
  {
   "start": 297.49,
   "end": 305.09,
   "v": "m",
   "text": "یہ اچھی ہونی چاہیے۔ اپنے کھروں سے وہ رسی باندھنے میں"
  },
  {
   "start": 305.09,
   "end": 307.2,
   "v": "m",
   "text": "مجھے صدیاں لگ گئیں۔"
  },
  {
   "start": 307.5,
   "end": 313.89,
   "v": "m2",
   "text": "اب کھروں کی کوئی ضرورت نہیں۔ بھیڑوں والا کام ختم۔ وقت اڑ جاتا ہے۔"
  },
  {
   "start": 313.89,
   "end": 321.25,
   "v": "m",
   "text": "رکیے رکیے رکیے! یہ چلتی کیسے ہے؟ میرا مطلب ہے، میں اسے کیسے چلاؤں؟"
  },
  {
   "start": 321.27,
   "end": 321.67,
   "v": "m2",
   "text": "آپ نہیں چلاتے۔"
  },
  {
   "start": 322.55,
   "end": 324.07,
   "v": "m2",
   "text": "میں نے آپ کے لیے چلا دی ہے۔"
  },
  {
   "start": 326.39,
   "end": 327.13,
   "v": "m",
   "text": "میں کب جاؤں گا؟"
  },
  {
   "start": 328.93,
   "end": 330.27,
   "v": "m",
   "text": "کہاں جاؤں گا؟"
  },
  {
   "start": 330.27,
   "end": 331.89,
   "v": "m2",
   "text": "ہم آپ کو لے لیں گے۔ فکر نہ کریں۔"
  },
  {
   "start": 332.39,
   "end": 335.17,
   "v": "m2",
   "text": "بس یہیں رہیے۔ بالکل اسی جگہ۔"
  },
  {
   "start": 335.29,
   "end": 335.69,
   "v": "m2",
   "text": "ہلیے مت۔"
  },
  {
   "start": 336.45,
   "end": 336.79,
   "v": "m2",
   "text": "بس انتظار۔"
  },
  {
   "start": 338.27,
   "end": 339.09,
   "v": "m",
   "text": "بس؟"
  },
  {
   "start": 341.12,
   "end": 341.46,
   "v": "m",
   "text": "ارے!"
  },
  {
   "start": 342.64,
   "end": 343.14,
   "v": "m",
   "text": "ارے!"
  },
  {
   "start": 344.2,
   "end": 345.76,
   "v": "m",
   "text": "رکیے، جناب!"
  },
  {
   "start": 347.42,
   "end": 350.2,
   "v": "m",
   "text": "کیسپر، ہیکٹر، جو بھی ہو!"
  }
 ]
}