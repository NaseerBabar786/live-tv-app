{
 "film": "tears-of-steel",
 "lang": "hi",
 "segments": [
  {
   "start": 4.34,
   "end": 9.84,
   "v": "m",
   "text": "मेन इंजन स्टार्ट। चार, तीन, दो, एक।"
  },
  {
   "start": 24.27,
   "end": 26.97,
   "v": "m",
   "text": "देखो सीलिया, हमें अपने शौक़ पूरे करने हैं।"
  },
  {
   "start": 26.99,
   "end": 30.2,
   "v": "m",
   "text": "तुम्हारे पास रोबोट हैं, और मैं अंतरिक्ष में कमाल करना चाहता हूँ।"
  },
  {
   "start": 30.3,
   "end": 34.3,
   "v": "f",
   "text": "साफ़ मान क्यों नहीं लेते कि तुम्हें मेरे रोबोट हाथ से डर लगता है?"
  },
  {
   "start": 34.4,
   "end": 35.95,
   "v": "m",
   "text": "डर नहीं लगता, बस…"
  },
  {
   "start": 37.41,
   "end": 39.45,
   "v": "m",
   "text": "अच्छा ठीक है, डर लगता है।"
  },
  {
   "start": 39.6,
   "end": 42.2,
   "v": "m",
   "text": "मुझे सपने आते हैं कि बड़े बड़े रोबोट पंजे मेरा पीछा कर रहे हैं।"
  },
  {
   "start": 42.3,
   "end": 43.37,
   "v": "f",
   "text": "जो भी हो, टॉम!"
  },
  {
   "start": 44.27,
   "end": 44.97,
   "v": "f",
   "text": "बस, ख़त्म!"
  },
  {
   "start": 50.16,
   "end": 53.56,
   "v": "f",
   "text": "रोबोट की याददाश्त जुड़ गई और लॉक हो गई।"
  },
  {
   "start": 60.98,
   "end": 62.3,
   "v": "m",
   "text": "ये तो बड़ा अजीब है।"
  },
  {
   "start": 117.76,
   "end": 118.62,
   "v": "m",
   "text": "तुम्हें नीचे नहीं होना चाहिए?"
  },
  {
   "start": 131.34,
   "end": 132.84,
   "v": "m",
   "text": "मैंने कल रात तुम्हारी बातें सुनी थीं।"
  },
  {
   "start": 136.49,
   "end": 137.69,
   "v": "m",
   "text": "इसमें मेरी कोई ग़लती नहीं।"
  },
  {
   "start": 191.43,
   "end": 192.01,
   "v": "m",
   "text": "तैयार हो?"
  },
  {
   "start": 192.75,
   "end": 194.49,
   "v": "m",
   "text": "ज़ाहिर है तैयार हो, तुम तो स्टार हो।"
  },
  {
   "start": 197.14,
   "end": 198.6,
   "v": "m",
   "text": "क्या हाल है, बार्ली?"
  },
  {
   "start": 198.7,
   "end": 200.38,
   "v": "m2",
   "text": "लगभग दस मिनट हैं।"
  },
  {
   "start": 201.58,
   "end": 202.68,
   "v": "m",
   "text": "बहुत बढ़िया।"
  },
  {
   "start": 203.58,
   "end": 206.46,
   "v": "m2",
   "text": "सारे सिस्टम तैयार! चलो!"
  },
  {
   "start": 206.6,
   "end": 207.44,
   "v": "m",
   "text": "हाँ, चलो!"
  },
  {
   "start": 212.11,
   "end": 214.07,
   "v": "m",
   "text": "ज़बरदस्त!"
  },
  {
   "start": 214.29,
   "end": 214.87,
   "v": "m",
   "text": "चलो!"
  },
  {
   "start": 222.94,
   "end": 225.62,
   "v": "m2",
   "text": "अच्छा है। फ़िक्र की कोई बात नहीं।"
  },
  {
   "start": 232.18,
   "end": 232.9,
   "v": "m2",
   "text": "वो रही।"
  },
  {
   "start": 235.61,
   "end": 236.59,
   "v": "m2",
   "text": "तुम उससे प्यार करते हो।"
  },
  {
   "start": 237.51,
   "end": 238.37,
   "v": "m2",
   "text": "वो तुम्हारा जुनून है।"
  },
  {
   "start": 239.19,
   "end": 240.75,
   "v": "m2",
   "text": "उससे नरमी से बात करो।"
  },
  {
   "start": 241.55,
   "end": 242.01,
   "v": "m2",
   "text": "सच बोलो।"
  },
  {
   "start": 243.43,
   "end": 244.17,
   "v": "m2",
   "text": "नरमी से।"
  },
  {
   "start": 245.49,
   "end": 247.97,
   "v": "m2",
   "text": "उसे याद दिलाओ कि प्यार क्या होता है।"
  },
  {
   "start": 297.15,
   "end": 298.21,
   "v": "f",
   "text": "ओवरराइड जारी है!"
  },
  {
   "start": 299.37,
   "end": 300.47,
   "v": "f",
   "text": "तुम बहुत बुरे हो, टॉम!"
  },
  {
   "start": 302.13,
   "end": 302.85,
   "v": "m",
   "text": "ओह, माफ़ करना!"
  },
  {
   "start": 303.77,
   "end": 305.07,
   "v": "m",
   "text": "माफ़ करना।"
  },
  {
   "start": 316.18,
   "end": 323.68,
   "v": "m",
   "text": "देखो सीलिया, हमें अपने शौक़ पूरे करने हैं। तुम्हारे पास रोबोट हैं।"
  },
  {
   "start": 325.28,
   "end": 328.18,
   "v": "m",
   "text": "और मैं अंतरिक्ष में कमाल करना चाहता हूँ।"
  },
  {
   "start": 338.77,
   "end": 350.01,
   "v": "f",
   "text": "साफ़ मान क्यों नहीं लेते कि तुम्हें मेरे रोबोट हाथ से डर लगता है?"
  },
  {
   "start": 356.12,
   "end": 362.88,
   "v": "m2",
   "text": "सीलिया, मैं तब कम उम्र और बेवक़ूफ़ था, पर इसके लिए दुनिया तबाह करने की कोई वजह नहीं।"
  },
  {
   "start": 365.09,
   "end": 365.87,
   "v": "m",
   "text": "ये ऐसा क्यों करता है?"
  },
  {
   "start": 366.91,
   "end": 368.47,
   "v": "m",
   "text": "ये हम पहले आज़मा चुके हैं।"
  },
  {
   "start": 383.49,
   "end": 384.87,
   "v": "f",
   "text": "तुमने मेरा दिल तोड़ा।"
  },
  {
   "start": 386.09,
   "end": 386.8,
   "v": "m2",
   "text": "जानता हूँ।"
  },
  {
   "start": 386.9,
   "end": 388.57,
   "v": "f",
   "text": "तुम मुझे धरती पर भूल गए।"
  },
  {
   "start": 389.23,
   "end": 389.8,
   "v": "m2",
   "text": "नहीं।"
  },
  {
   "start": 389.9,
   "end": 392.13,
   "v": "f",
   "text": "मुझे तुम्हें कुचल देना चाहिए।"
  },
  {
   "start": 407.55,
   "end": 408.11,
   "v": "m2",
   "text": "मुझे माफ़ कर दो।"
  },
  {
   "start": 410.42,
   "end": 410.94,
   "v": "m",
   "text": "अच्छी बात बनाई।"
  },
  {
   "start": 505.08,
   "end": 508.22,
   "v": "m",
   "text": "अस्सी प्रतिशत। कप्तान, हमें रुकना होगा।"
  },
  {
   "start": 519.13,
   "end": 519.75,
   "v": "m2",
   "text": "दुनिया बदल गई, सीलिया।"
  },
  {
   "start": 561.73,
   "end": 564.03,
   "v": "m",
   "text": "इससे एक सबक़ मिलता है।"
  },
  {
   "start": 566.03,
   "end": 566.69,
   "v": "m",
   "text": "इससे बुरा भी हो सकता था।"
  }
 ]
}