{
 "film": "tears-of-steel",
 "lang": "ur",
 "segments": [
  {
   "start": 4.34,
   "end": 9.84,
   "v": "m",
   "text": "مین انجن اسٹارٹ۔ چار، تین، دو، ایک۔"
  },
  {
   "start": 24.27,
   "end": 26.97,
   "v": "m",
   "text": "دیکھو سیلیا، ہمیں اپنے شوق پورے کرنے ہیں۔"
  },
  {
   "start": 26.99,
   "end": 30.2,
   "v": "m",
   "text": "تمہارے پاس روبوٹ ہیں، اور میں خلا میں کمال کرنا چاہتا ہوں۔"
  },
  {
   "start": 30.3,
   "end": 34.3,
   "v": "f",
   "text": "صاف مان کیوں نہیں لیتے کہ تمہیں میرے روبوٹ ہاتھ سے ڈر لگتا ہے؟"
  },
  {
   "start": 34.4,
   "end": 35.95,
   "v": "m",
   "text": "ڈر نہیں لگتا، بس…"
  },
  {
   "start": 37.41,
   "end": 39.45,
   "v": "m",
   "text": "اچھا ٹھیک ہے، ڈر لگتا ہے۔"
  },
  {
   "start": 39.6,
   "end": 42.2,
   "v": "m",
   "text": "مجھے خواب آتے ہیں کہ بڑے بڑے روبوٹ پنجے میرا پیچھا کر رہے ہیں۔"
  },
  {
   "start": 42.3,
   "end": 43.37,
   "v": "f",
   "text": "جو بھی ہو، ٹام!"
  },
  {
   "start": 44.27,
   "end": 44.97,
   "v": "f",
   "text": "بس، ختم!"
  },
  {
   "start": 50.16,
   "end": 53.56,
   "v": "f",
   "text": "روبوٹ کی یادداشت جڑ گئی اور محفوظ ہو گئی۔"
  },
  {
   "start": 60.98,
   "end": 62.3,
   "v": "m",
   "text": "یہ تو بڑا عجیب ہے۔"
  },
  {
   "start": 117.76,
   "end": 118.62,
   "v": "m",
   "text": "تمہیں نیچے نہیں ہونا چاہیے؟"
  },
  {
   "start": 131.34,
   "end": 132.84,
   "v": "m",
   "text": "میں نے کل رات تمہاری باتیں سنی تھیں۔"
  },
  {
   "start": 136.49,
   "end": 137.69,
   "v": "m",
   "text": "اس میں میرا کوئی قصور نہیں۔"
  },
  {
   "start": 191.43,
   "end": 192.01,
   "v": "m",
   "text": "تیار ہو؟"
  },
  {
   "start": 192.75,
   "end": 194.49,
   "v": "m",
   "text": "ظاہر ہے تیار ہو، تم تو اسٹار ہو۔"
  },
  {
   "start": 197.14,
   "end": 198.6,
   "v": "m",
   "text": "کیا حال ہے، بارلی؟"
  },
  {
   "start": 198.7,
   "end": 200.38,
   "v": "m2",
   "text": "تقریباً دس منٹ ہیں۔"
  },
  {
   "start": 201.58,
   "end": 202.68,
   "v": "m",
   "text": "بہت خوب۔"
  },
  {
   "start": 203.58,
   "end": 206.46,
   "v": "m2",
   "text": "سب سسٹم تیار! چلو!"
  },
  {
   "start": 206.6,
   "end": 207.44,
   "v": "m",
   "text": "ہاں، چلو!"
  },
  {
   "start": 212.11,
   "end": 214.07,
   "v": "m",
   "text": "زبردست!"
  },
  {
   "start": 214.29,
   "end": 214.87,
   "v": "m",
   "text": "چلو!"
  },
  {
   "start": 222.94,
   "end": 225.62,
   "v": "m2",
   "text": "اچھا ہے۔ فکر کی کوئی بات نہیں۔"
  },
  {
   "start": 232.18,
   "end": 232.9,
   "v": "m2",
   "text": "وہ رہی۔"
  },
  {
   "start": 235.61,
   "end": 236.59,
   "v": "m2",
   "text": "تم اس سے پیار کرتے ہو۔"
  },
  {
   "start": 237.51,
   "end": 238.37,
   "v": "m2",
   "text": "وہ تمہارا جنون ہے۔"
  },
  {
   "start": 239.19,
   "end": 240.75,
   "v": "m2",
   "text": "اس سے نرمی سے بات کرو۔"
  },
  {
   "start": 241.55,
   "end": 242.01,
   "v": "m2",
   "text": "سچ بولو۔"
  },
  {
   "start": 243.43,
   "end": 244.17,
   "v": "m2",
   "text": "نرمی سے۔"
  },
  {
   "start": 245.49,
   "end": 247.97,
   "v": "m2",
   "text": "اسے یاد دلاؤ کہ محبت کیا ہوتی ہے۔"
  },
  {
   "start": 297.15,
   "end": 298.21,
   "v": "f",
   "text": "اوور رائیڈ جاری ہے!"
  },
  {
   "start": 299.37,
   "end": 300.47,
   "v": "f",
   "text": "تم بہت برے ہو، ٹام!"
  },
  {
   "start": 302.13,
   "end": 302.85,
   "v": "m",
   "text": "اوہ، معاف کرنا!"
  },
  {
   "start": 303.77,
   "end": 305.07,
   "v": "m",
   "text": "معاف کرنا۔"
  },
  {
   "start": 316.18,
   "end": 323.68,
   "v": "m",
   "text": "دیکھو سیلیا، ہمیں اپنے شوق پورے کرنے ہیں۔ تمہارے پاس روبوٹ ہیں۔"
  },
  {
   "start": 325.28,
   "end": 328.18,
   "v": "m",
   "text": "اور میں خلا میں کمال کرنا چاہتا ہوں۔"
  },
  {
   "start": 338.77,
   "end": 350.01,
   "v": "f",
   "text": "صاف مان کیوں نہیں لیتے کہ تمہیں میرے روبوٹ ہاتھ سے ڈر لگتا ہے؟"
  },
  {
   "start": 356.12,
   "end": 362.88,
   "v": "m2",
   "text": "سیلیا، میں اس وقت کم عمر اور بے وقوف تھا، مگر اس کے لیے دنیا تباہ کرنے کی کوئی وجہ نہیں۔"
  },
  {
   "start": 365.09,
   "end": 365.87,
   "v": "m",
   "text": "یہ ایسا کیوں کرتا ہے؟"
  },
  {
   "start": 366.91,
   "end": 368.47,
   "v": "m",
   "text": "یہ ہم پہلے آزما چکے ہیں۔"
  },
  {
   "start": 383.49,
   "end": 384.87,
   "v": "f",
   "text": "تم نے میرا دل توڑا۔"
  },
  {
   "start": 386.09,
   "end": 386.8,
   "v": "m2",
   "text": "جانتا ہوں۔"
  },
  {
   "start": 386.9,
   "end": 388.57,
   "v": "f",
   "text": "تم مجھے زمین پر بھول گئے۔"
  },
  {
   "start": 389.23,
   "end": 389.8,
   "v": "m2",
   "text": "نہیں۔"
  },
  {
   "start": 389.9,
   "end": 392.13,
   "v": "f",
   "text": "مجھے تمہیں کچل دینا چاہیے۔"
  },
  {
   "start": 407.55,
   "end": 408.11,
   "v": "m2",
   "text": "مجھے معاف کر دو۔"
  },
  {
   "start": 410.42,
   "end": 410.94,
   "v": "m",
   "text": "اچھی بات بنائی۔"
  },
  {
   "start": 505.08,
   "end": 508.22,
   "v": "m",
   "text": "اسی فیصد۔ کپتان، ہمیں رکنا ہوگا۔"
  },
  {
   "start": 519.13,
   "end": 519.75,
   "v": "m2",
   "text": "دنیا بدل گئی، سیلیا۔"
  },
  {
   "start": 561.73,
   "end": 564.03,
   "v": "m",
   "text": "اس سے ایک سبق ملتا ہے۔"
  },
  {
   "start": 566.03,
   "end": 566.69,
   "v": "m",
   "text": "اس سے برا بھی ہو سکتا تھا۔"
  }
 ]
}