{
 "film": "cosmos-laundromat",
 "lang": "hi",
 "segments": [
  {
   "start": 139.98,
   "end": 140.92,
   "v": "m2",
   "text": "माफ़ कीजिए।"
  },
  {
   "start": 142.06,
   "end": 142.76,
   "v": "m2",
   "text": "माफ़ कीजिए, जनाब।"
  },
  {
   "start": 144.14,
   "end": 144.82,
   "v": "m2",
   "text": "सुनिए।"
  },
  {
   "start": 150.37,
   "end": 151.19,
   "v": "m2",
   "text": "एक मिनट है, जनाब?"
  },
  {
   "start": 152.33,
   "end": 154.83,
   "v": "m",
   "text": "मैं ज़रा एक काम में लगा हूँ।"
  },
  {
   "start": 155.13,
   "end": 156.45,
   "v": "m2",
   "text": "जी, शुक्रिया।"
  },
  {
   "start": 156.83,
   "end": 158.01,
   "v": "m2",
   "text": "मैं आपके लिए बहुत दूर से आया हूँ, फ़्रैंक।"
  },
  {
   "start": 169.42,
   "end": 170.14,
   "v": "m2",
   "text": "मेरा नाम विक्टर है।"
  },
  {
   "start": 175.02,
   "end": 175.96,
   "v": "m2",
   "text": "और आप हैं…"
  },
  {
   "start": 177.46,
   "end": 178.26,
   "v": "m",
   "text": "फ़्रैंक।"
  },
  {
   "start": 180.52,
   "end": 183.9,
   "v": "m2",
   "text": "आप सिर्फ़ एक भेड़ से कहीं बढ़कर हैं, है ना?"
  },
  {
   "start": 184.8,
   "end": 185.28,
   "v": "m",
   "text": "अच्छा?"
  },
  {
   "start": 186.78,
   "end": 188.04,
   "v": "m",
   "text": "आपको कैसे पता?"
  },
  {
   "start": 190.44,
   "end": 192.54,
   "v": "m2",
   "text": "ख़ुद को देखिए। आप साहसी हैं, फ़्रैंक।"
  },
  {
   "start": 192.54,
   "end": 196.52,
   "v": "m2",
   "text": "बिल्कुल मेरी तरह, अकेले भेड़िये।"
  },
  {
   "start": 198.75,
   "end": 201.71,
   "v": "m2",
   "text": "बताइए, क्या कोई अपनी मर्ज़ी से अकेला होता है?"
  },
  {
   "start": 202.97,
   "end": 204.37,
   "v": "m2",
   "text": "नहीं, नहीं होता।"
  },
  {
   "start": 205.09,
   "end": 207.01,
   "v": "m2",
   "text": "कोई भेड़िया बनना भी ख़ुद नहीं चुनता।"
  },
  {
   "start": 209.99,
   "end": 210.59,
   "v": "m2",
   "text": "या चुनता है?"
  },
  {
   "start": 215.49,
   "end": 217.17,
   "v": "m",
   "text": "देखिए, जनाब…"
  },
  {
   "start": 217.89,
   "end": 219.61,
   "v": "m2",
   "text": "विक्टर। विक्टर।"
  },
  {
   "start": 219.95,
   "end": 225.19,
   "v": "m",
   "text": "मुझे नहीं पता आप क्या कह रहे हैं, मैं तो एक भेड़ हूँ जो अपने काम से काम रखती है।"
  },
  {
   "start": 226.51,
   "end": 228.73,
   "v": "m",
   "text": "आप भी यही कीजिए।"
  },
  {
   "start": 228.73,
   "end": 236.23,
   "v": "m2",
   "text": "नहीं नहीं नहीं, फ़्रैंक, रुकिए, रुकिए! ये तरीक़ा नहीं। बस मुझे एक मिनट दीजिए,"
  },
  {
   "start": 236.23,
   "end": 243.51,
   "v": "m2",
   "text": "आपके क़ीमती वक़्त का। हाँ, बस एक मिनट।"
  },
  {
   "start": 243.51,
   "end": 246.23,
   "v": "m2",
   "text": "एक मिनट तो होगा आपके पास, है ना?"
  },
  {
   "start": 247.83,
   "end": 250.85,
   "v": "m2",
   "text": "अच्छा, आधा। आधा मिनट।"
  },
  {
   "start": 270.18,
   "end": 277.22,
   "v": "m2",
   "text": "आपको पछतावा नहीं होगा! कैसे कैसे सफ़र, वो सारी ज़िंदगियाँ जो आप"
  },
  {
   "start": 277.22,
   "end": 284.24,
   "v": "m2",
   "text": "हमेशा चाहते थे, जो कुछ आपसे छूट गया। हाँ, ये हमारी दुकान की"
  },
  {
   "start": 284.24,
   "end": 291.44,
   "v": "m2",
   "text": "सबसे बढ़िया चीज़ है। बदलती रफ़्तार, शानदार घुमाव, सब एक ही"
  },
  {
   "start": 291.44,
   "end": 295.38,
   "v": "m2",
   "text": "मशीन में। बिल्कुल साफ़ सुथरी।"
  },
  {
   "start": 297.49,
   "end": 305.09,
   "v": "m",
   "text": "ये अच्छी होनी चाहिए। अपने खुरों से वो रस्सी बाँधने में"
  },
  {
   "start": 305.09,
   "end": 307.2,
   "v": "m",
   "text": "मुझे सदियाँ लग गईं।"
  },
  {
   "start": 307.5,
   "end": 313.89,
   "v": "m2",
   "text": "अब खुरों की कोई ज़रूरत नहीं। भेड़ों वाला काम ख़त्म। वक़्त उड़ जाता है।"
  },
  {
   "start": 313.89,
   "end": 321.25,
   "v": "m",
   "text": "रुकिए रुकिए रुकिए! ये चलती कैसे है? मेरा मतलब है, मैं इसे कैसे चलाऊँ?"
  },
  {
   "start": 321.27,
   "end": 321.67,
   "v": "m2",
   "text": "आप नहीं चलाते।"
  },
  {
   "start": 322.55,
   "end": 324.07,
   "v": "m2",
   "text": "मैंने आपके लिए चला दी है।"
  },
  {
   "start": 326.39,
   "end": 327.13,
   "v": "m",
   "text": "मैं कब जाऊँगा?"
  },
  {
   "start": 328.93,
   "end": 330.27,
   "v": "m",
   "text": "कहाँ जाऊँगा?"
  },
  {
   "start": 330.27,
   "end": 331.89,
   "v": "m2",
   "text": "हम आपको ले लेंगे। फ़िक्र न करें।"
  },
  {
   "start": 332.39,
   "end": 335.17,
   "v": "m2",
   "text": "बस यहीं रहिए। बिल्कुल इसी जगह।"
  },
  {
   "start": 335.29,
   "end": 335.69,
   "v": "m2",
   "text": "हिलिए मत।"
  },
  {
   "start": 336.45,
   "end": 336.79,
   "v": "m2",
   "text": "बस इंतज़ार।"
  },
  {
   "start": 338.27,
   "end": 339.09,
   "v": "m",
   "text": "बस?"
  },
  {
   "start": 341.12,
   "end": 341.46,
   "v": "m",
   "text": "अरे!"
  },
  {
   "start": 342.64,
   "end": 343.14,
   "v": "m",
   "text": "अरे!"
  },
  {
   "start": 344.2,
   "end": 345.76,
   "v": "m",
   "text": "रुकिए, जनाब!"
  },
  {
   "start": 347.42,
   "end": 350.2,
   "v": "m",
   "text": "कैस्पर, हेक्टर, जो भी हो!"
  }
 ]
}