 "segments": [
  {
   "start": 14.93,
   "end": 21.85,
   "v": "m2",
   "text": "بائیں طرف ہم دیکھ سکتے ہیں… دائیں طرف ہم دیکھ سکتے ہیں… ٹوپی والے!"
  },
  {
   "start": 22.19,
   "end": 24.55,
   "v": "m2",
   "text": "سب محفوظ ہے، بالکل محفوظ۔"
  },
  {
   "start": 25.13,
   "end": 25.45,
   "v": "m2",
   "text": "ایمو؟"
  },
  {
   "start": 26.35,
   "end": 26.87,
   "v": "m2",
   "text": "ایمو۔"
  },
  {
   "start": 28.41,
   "end": 29.29,
   "v": "m",
   "text": "یہ کیا ہے؟"
  },
  {
   "start": 46.31,
   "end": 47.57,
   "v": "m2",
   "text": "چوٹ تو نہیں لگی؟"
  },
  {
   "start": 51.97,
   "end": 53.87,
   "v": "m",
   "text": "شاید نہیں۔ آپ کو؟"
  },
  {
   "start": 55.33,
   "end": 58.85,
   "v": "m2",
   "text": "میں ٹھیک ہوں۔ اٹھو، ایمو۔"
  },
  {
   "start": 59.43,
   "end": 61.17,
   "v": "m2",
   "text": "یہاں خطرہ ہے۔"
  },
  {
   "start": 62.01,
   "end": 62.79,
   "v": "m2",
   "text": "چلو۔"
  },
  {
   "start": 63.63,
   "end": 64.25,
   "v": "m",
   "text": "آگے کیا ہے؟"
  },
  {
   "start": 65.59,
   "end": 66.69,
   "v": "m2",
   "text": "دیکھ لو گے۔"
  },
  {
   "start": 67.83,
   "end": 68.75,
   "v": "m2",
   "text": "دیکھ لو گے۔"
  },
  {
   "start": 76.82,
   "end": 77.78,
   "v": "m2",
   "text": "اس طرف۔"
  },
  {
   "start": 94.67,
   "end": 95.29,
   "v": "m2",
   "text": "میرے پیچھے آؤ!"
  },
  {
   "start": 130.74,
   "end": 132.14,
   "v": "m2",
   "text": "جلدی کرو، ایمو!"
  },
  {
   "start": 135.87,
   "end": 137.61,
   "v": "m2",
   "text": "سنو۔ سنو۔"
  },
  {
   "start": 138.63,
   "end": 138.83,
   "v": "m2",
   "text": "سنو۔"
  },
  {
   "start": 140.99,
   "end": 141.79,
   "v": "m2",
   "text": "سنو۔"
  },
  {
   "start": 142.55,
   "end": 145.03,
   "v": "m2",
   "text": "سنو۔ سنو۔ سنو۔"
  },
  {
   "start": 168.02,
   "end": 169.7,
   "v": "m2",
   "text": "تم دھیان نہیں دے رہے۔"
  },
  {
   "start": 170.5,
   "end": 173.88,
   "v": "m",
   "text": "میں بس فون اٹھانا چاہتا ہوں۔"
  },
  {
   "start": 174.74,
   "end": 176.96,
   "v": "m2",
   "text": "ایمو، دیکھو۔ میرا مطلب ہے سنو۔"
  },
  {
   "start": 179.6,
   "end": 181.76,
   "v": "m2",
   "text": "تمہیں سننا سیکھنا ہوگا۔"
  },
  {
   "start": 182.68,
   "end": 190.44,
   "v": "m2",
   "text": "یہ کوئی کھیل نہیں۔ تم… میرا مطلب ہے ہم، یہاں آسانی سے مر سکتے ہیں۔ سنو…"
  },
  {
   "start": 190.44,
   "end": 193.74,
   "v": "m2",
   "text": "مشین کی آوازیں سنو۔"
  },
  {
   "start": 197.42,
   "end": 199.42,
   "v": "m2",
   "text": "اپنی سانسیں سنو۔"
  },
  {
   "start": 266.08,
   "end": 269.4,
   "v": "m",
   "text": "آپ کبھی اس سب سے تھکتے نہیں؟"
  },
  {
   "start": 269.56,
   "end": 279.0,
   "v": "m2",
   "text": "تھکنا؟ ایمو، یہ مشین گھڑی کی طرح چلتی ہے۔ ایک قدم غلط پڑا، اور تم پس کر رہ جاؤ گے۔"
  },
  {
   "start": 281.43,
   "end": 283.47,
   "v": "m2",
   "text": "پسنا اچھا لگے گا، ایمو؟"
  },
  {
   "start": 284.17,
   "end": 286.15,
   "v": "m2",
   "text": "یہی چاہتے ہو؟ پس جانا؟"
  },
  {
   "start": 287.57,
   "end": 289.69,
   "v": "m2",
   "text": "ایمو، زندگی کا مقصد…"
  },
  {
   "start": 290.85,
   "end": 291.33,
   "v": "m2",
   "text": "پس جانا؟"
  },
  {
   "start": 341.6,
   "end": 343.28,
   "v": "m2",
   "text": "ایمو، آنکھیں بند کرو۔"
  },
  {
   "start": 344.62,
   "end": 345.05,
   "v": "m",
   "text": "کیوں؟"
  },
  {
   "start": 345.1,
   "end": 345.6,
   "v": "m2",
   "text": "ابھی!"
  },
  {
   "start": 359.64,
   "end": 361.68,
   "v": "m2",
   "text": "بائیں طرف کیا دکھتا ہے، ایمو؟"
  },
  {
   "start": 361.92,
   "end": 362.14,
   "v": "m2",
   "text": "بولو؟"
  },
  {
   "start": 363.82,
   "end": 364.5,
