{
 "film": "elephants-dream",
 "lang": "hi",
 "segments": [
  {
   "start": 14.93,
   "end": 21.85,
   "v": "m2",
   "text": "बाएँ तरफ़ हम देख सकते हैं… दाएँ तरफ़ हम देख सकते हैं… टोपी वाले!"
  },
  {
   "start": 22.19,
   "end": 24.55,
   "v": "m2",
   "text": "सब सुरक्षित है, बिल्कुल सुरक्षित।"
  },
  {
   "start": 25.13,
   "end": 25.45,
   "v": "m2",
   "text": "एमो?"
  },
  {
   "start": 26.35,
   "end": 26.87,
   "v": "m2",
   "text": "एमो।"
  },
  {
   "start": 28.41,
   "end": 29.29,
   "v": "m",
   "text": "ये क्या है?"
  },
  {
   "start": 46.31,
   "end": 47.57,
   "v": "m2",
   "text": "चोट तो नहीं लगी?"
  },
  {
   "start": 51.97,
   "end": 53.87,
   "v": "m",
   "text": "शायद नहीं। आपको?"
  },
  {
   "start": 55.33,
   "end": 58.85,
   "v": "m2",
   "text": "मैं ठीक हूँ। उठो, एमो।"
  },
  {
   "start": 59.43,
   "end": 61.17,
   "v": "m2",
   "text": "यहाँ ख़तरा है।"
  },
  {
   "start": 62.01,
   "end": 62.79,
   "v": "m2",
   "text": "चलो।"
  },
  {
   "start": 63.63,
   "end": 64.25,
   "v": "m",
   "text": "आगे क्या है?"
  },
  {
   "start": 65.59,
   "end": 66.69,
   "v": "m2",
   "text": "देख लोगे।"
  },
  {
   "start": 67.83,
   "end": 68.75,
   "v": "m2",
   "text": "देख लोगे।"
  },
  {
   "start": 76.82,
   "end": 77.78,
   "v": "m2",
   "text": "इस तरफ़।"
  },
  {
   "start": 94.67,
   "end": 95.29,
   "v": "m2",
   "text": "मेरे पीछे आओ!"
  },
  {
   "start": 130.74,
   "end": 132.14,
   "v": "m2",
   "text": "जल्दी करो, एमो!"
  },
  {
   "start": 135.87,
   "end": 137.61,
   "v": "m2",
   "text": "सुनो। सुनो।"
  },
  {
   "start": 138.63,
   "end": 138.83,
   "v": "m2",
   "text": "सुनो।"
  },
  {
   "start": 140.99,
   "end": 141.79,
   "v": "m2",
   "text": "सुनो।"
  },
  {
   "start": 142.55,
   "end": 145.03,
   "v": "m2",
   "text": "सुनो। सुनो। सुनो।"
  },
  {
   "start": 168.02,
   "end": 169.7,
   "v": "m2",
   "text": "तुम ध्यान नहीं दे रहे।"
  },
  {
   "start": 170.5,
   "end": 173.88,
   "v": "m",
   "text": "मैं बस फ़ोन उठाना चाहता हूँ।"
  },
  {
   "start": 174.74,
   "end": 176.96,
   "v": "m2",
   "text": "एमो, देखो। मेरा मतलब है सुनो।"
  },
  {
   "start": 179.6,
   "end": 181.76,
   "v": "m2",
   "text": "तुम्हें सुनना सीखना होगा।"
  },
  {
   "start": 182.68,
   "end": 190.44,
   "v": "m2",
   "text": "ये कोई खेल नहीं। तुम… मेरा मतलब है हम, यहाँ आसानी से मर सकते हैं। सुनो…"
  },
  {
   "start": 190.44,
   "end": 193.74,
   "v": "m2",
   "text": "मशीन की आवाज़ें सुनो।"
  },
  {
   "start": 197.42,
   "end": 199.42,
   "v": "m2",
   "text": "अपनी साँसें सुनो।"
  },
  {
   "start": 266.08,
   "end": 269.4,
   "v": "m",
   "text": "आप कभी इस सब से थकते नहीं?"
  },
  {
   "start": 269.56,
   "end": 279.0,
   "v": "m2",
   "text": "थकना? एमो, ये मशीन घड़ी की तरह चलती है। एक क़दम ग़लत पड़ा, और तुम पिस कर रह जाओगे।"
  },
  {
   "start": 281.43,
   "end": 283.47,
   "v": "m2",
   "text": "पिसना अच्छा लगेगा, एमो?"
  },
  {
   "start": 284.17,
   "end": 286.15,
   "v": "m2",
   "text": "यही चाहते हो? पिस जाना?"
  },
  {
   "start": 287.57,
   "end": 289.69,
   "v": "m2",
   "text": "एमो, ज़िंदगी का मक़सद…"
  },
  {
   "start": 290.85,
   "end": 291.33,
   "v": "m2",
   "text": "पिस जाना?"
  },
  {
   "start": 341.6,
   "end": 343.28,
   "v": "m2",
   "text": "एमो, आँखें बंद करो।"
  },
  {
   "start": 344.62,
   "end": 345.05,
   "v": "m",
   "text": "क्यों?"
  },
  {
   "start": 345.1,
   "end": 345.6,
   "v": "m2",
   "text": "अभी!"
  },
  {
   "start": 359.64,
   "end": 361.68,
   "v": "m2",
   "text": "बाईं तरफ़ क्या दिखता है, एमो?"
  },
  {
   "start": 361.92,
   "end": 362.14,
   "v": "m2",
   "text": "बोलो?"
  },
  {
   "start": 363.82,
   "end": 364.5,
   "v": "m",
   "text": "कुछ नहीं।"
  },
  {
   "start": 364.6,
   "end": 365.24,
   "v": "m2",
   "text": "सच?"
  },
  {
   "start": 366.46,
   "end": 367.5,
   "v": "m",
   "text": "नहीं, कुछ भी नहीं।"
  },
  {
   "start": 367.6,
   "end": 368.12,
   "v": "m2",
   "text": "सच?"
  },
  {
   "start": 368.52,
   "end": 371.74,
   "v": "m2",
   "text": "और दाईं तरफ़? दाईं तरफ़ क्या दिखता है, एमो?"
  },
  {
   "start": 373.7,
   "end": 374.62,
   "v": "m",
   "text": "वही, प्रोग।"
  },
  {
   "start": 375.48,
   "end": 376.72,
   "v": "m",
   "text": "बिल्कुल वही।"
  },
  {
   "start": 377.06,
   "end": 377.36,
   "v": "m",
   "text": "कुछ नहीं।"
  },
  {
   "start": 378.4,
   "end": 378.7,
   "v": "m2",
   "text": "बहुत ख़ूब।"
  },
  {
   "start": 400.57,
   "end": 402.57,
   "v": "m",
   "text": "सुनिए, प्रोग। आपने सुना?"
  },
  {
   "start": 403.65,
   "end": 404.45,
   "v": "m",
   "text": "वहाँ चलें?"
  },
  {
   "start": 405.47,
   "end": 407.93,
   "v": "m2",
   "text": "वहाँ? वहाँ ख़तरा है, एमो।"
  },
  {
   "start": 409.59,
   "end": 410.6,
   "v": "m",
   "text": "लेकिन…"
  },
  {
   "start": 410.7,
   "end": 411.91,
   "v": "m2",
   "text": "मेरी बात मानो, ख़तरा है।"
  },
  {
   "start": 411.91,
   "end": 414.73,
   "v": "m",
   "text": "शायद मैं चला जाऊँ…"
  },
  {
   "start": 414.73,
   "end": 415.2,
   "v": "m2",
   "text": "नहीं!"
  },
  {
   "start": 417.5,
   "end": 419.56,
   "v": "m2",
   "text": "नहीं! नहीं!"
  },
  {
   "start": 421.2,
   "end": 423.06,
   "v": "m2",
   "text": "और कोई सवाल, एमो?"
  },
  {
   "start": 424.26,
   "end": 424.82,
   "v": "m",
   "text": "नहीं।"
  },
  {
   "start": 429.61,
   "end": 430.3,
   "v": "m2",
   "text": "एमो।"
  },
  {
   "start": 430.4,
   "end": 431.05,
   "v": "m",
   "text": "जी?"
  },
  {
   "start": 431.73,
   "end": 432.59,
   "v": "m2",
   "text": "एमो, क्यों?"
  },
  {
   "start": 433.49,
   "end": 435.07,
   "v": "m2",
   "text": "एमो, क्यों?"
  },
  {
   "start": 435.41,
   "end": 438.15,
   "v": "m2",
   "text": "तुम्हें इस जगह की ख़ूबसूरती क्यों नज़र नहीं आती?"
  },
  {
   "start": 439.07,
   "end": 440.35,
   "v": "m2",
   "text": "ये कैसे चलती है।"
  },
  {
   "start": 441.01,
   "end": 443.53,
   "v": "m2",
   "text": "कितनी… कितनी परफ़ेक्ट है।"
  },
  {
   "start": 444.43,
   "end": 447.11,
   "v": "m",
   "text": "नहीं, प्रोग। मुझे नज़र नहीं आती…"
  },
  {
   "start": 447.11,
   "end": 449.73,
   "v": "m",
   "text": "क्योंकि वहाँ कुछ है ही नहीं।"
  },
  {
   "start": 451.35,
   "end": 454.65,
   "v": "m",
   "text": "मैं अपनी जान ऐसी चीज़ के हवाले क्यों करूँ जो है ही नहीं?"
  },
  {
   "start": 455.63,
   "end": 457.35,
   "v": "m",
   "text": "आप मुझे क्या बता सकते हैं?"
  },
  {
   "start": 457.45,
   "end": 458.23,
   "v": "m2",
   "text": "एमो, जवाब दो।"
  },
  {
   "start": 463.78,
   "end": 464.08,
   "v": "m",
   "text": "प्रोग।"
  },
  {
   "start": 465.12,
   "end": 466.4,
   "v": "m",
   "text": "आप बीमार आदमी हैं।"
  },
  {
   "start": 466.92,
   "end": 468.38,
   "v": "m",
   "text": "मुझसे दूर रहिए।"
  },
  {
   "start": 468.48,
   "end": 468.94,
   "v": "m2",
   "text": "एमो।"
  },
  {
   "start": 472.42,
   "end": 474.46,
   "v": "m2",
   "text": "नहीं, एमो, ये जाल है।"
  },
  {
   "start": 475.72,
   "end": 479.48,
   "v": "m2",
   "text": "ये जाल है। बाईं तरफ़ देखो,"
  },
  {
   "start": 479.82,
   "end": 481.16,
   "v": "m2",
   "text": "बेबीलोन के झूलते बाग़।"
  },
  {
   "start": 482.24,
   "end": 483.32,
   "v": "m2",
   "text": "कैसा जाल है?"
  },
  {
   "start": 484.92,
   "end": 492.38,
   "v": "m2",
   "text": "और दाईं तरफ़ देखो…"
  },
  {
   "start": 492.38,
   "end": 499.52,
   "v": "m2",
   "text": "रोड्स की विशाल मूर्ति! और ये यहाँ सिर्फ़ तुम्हारे लिए है।"
  },
  {
   "start": 499.52,
   "end": 502.42,
   "v": "m2",
   "text": "सिर्फ़ तुम्हारे लिए।"
  },
  {
   "start": 533.26,
   "end": 539.32,
   "v": "m2",
   "text": "मैं सच कह रहा हूँ, एमो, ये है! ये है!"
  }
 ]
}