<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The recitation and the Azan recordings stream from the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app find the device's text-to-speech engine for the Qaida letter sounds. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <!-- The Azan at prayer time: full screen while it plays, or a banner for a chime, message or reminder. -->
        <activity
            android:name="com.iqraquran.app.ui.AzanActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity
            android:name="com.iqraquran.app.ui.AzanBannerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
